*.jsonl

# Logs und Dagster-Laufzeitdaten
logs/*
!logs/.gitkeep
*.log
.dagster/
dagster_home/

# Python und virtuelle Umgebungen
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/

# Editor und Betriebssystem
.vscode/
.idea/
.DS_Store
Thumbs.db
