# Umgebungsvariablen und Zugangsdaten (niemals committen)
.env
.env.*
!.env.example
*.key
*.pem

# Datenverzeichnisse und DuckDB-Dateien
data/*/*
!data/*/.gitkeep
data/prod/
data/demo/
*.duckdb
*.duckdb.wal
*.parquet
*.csv
*.tsv
*.xlsx
