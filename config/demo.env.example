# ==============================================================================
# DEMO-KONFIGURATION (Vorlage für .env.demo)
# Öffentlicher Lesezugriff, feste Datenauswahl, strikte Ressourcen- und Größenlimits
# ==============================================================================
APP_ENV=demo
DATA_DIR=./data/demo
INBOX_DIR=./data/demo/inbox
EXPORT_DIR=./data/demo/export
DUCKDB_PATH=./data/demo/mart/quality_platform_demo.duckdb
LOG_FILE=./logs/demo_platform.log
LOG_LEVEL=INFO

CHUNK_SIZE_ROWS=50000
MAX_UPLOAD_SIZE_MB=20
EXPORT_RETENTION_HOURS=24
EXPORT_MAX_TOTAL_MB=500
SMARD_WEEKS_COUNT=1

DEMO_READ_ONLY=true
ADMIN_PIN=change_me_in_demo_env

DAGSTER_PORT=3001
STREAMLIT_PORT=8501
