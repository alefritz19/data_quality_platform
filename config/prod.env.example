# ==============================================================================
# PRODUKTIV-KONFIGURATION (Vorlage für .env.prod)
# Vollständige Pipeline, volle Historie, geschützter lokaler/authentifizierter Zugriff
# ==============================================================================
APP_ENV=prod
DATA_DIR=./data/prod
INBOX_DIR=./data/prod/inbox
EXPORT_DIR=./data/prod/export
DUCKDB_PATH=./data/prod/mart/quality_platform_prod.duckdb
LOG_FILE=./logs/prod_platform.log
LOG_LEVEL=INFO

CHUNK_SIZE_ROWS=100000
MAX_UPLOAD_SIZE_MB=500
EXPORT_RETENTION_HOURS=72
EXPORT_MAX_TOTAL_MB=5000
SMARD_WEEKS_COUNT=4

DEMO_READ_ONLY=false
ADMIN_PIN=change_me_in_prod_env

DAGSTER_PORT=3000
STREAMLIT_PORT=8502
