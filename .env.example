# ==============================================================================
# KONFIGURATIONSVORLAGE (.env.example)
# Kopieren nach .env (lokal), .env.prod (Produktiv) oder .env.demo (Demo)
# ==============================================================================

# Umgebungskontext: prod | demo
APP_ENV=demo

# Pfade für Daten und DuckDB
DATA_DIR=./data
DUCKDB_PATH=./data/mart/quality_platform.duckdb
LOG_FILE=./logs/platform.log
LOG_LEVEL=INFO

# Dateiannahme und Chunk-Verarbeitung
INBOX_DIR=./data/inbox
CHUNK_SIZE_ROWS=100000
MAX_UPLOAD_SIZE_MB=20

# Temporäre Bereitstellung fertiger Daten (Aufbewahrung und Limits)
# Prod-Empfehlung: 72 Stunden, 5000 MB | Demo-Empfehlung: 24 Stunden, 500 MB
EXPORT_DIR=./data/export
EXPORT_RETENTION_HOURS=24
EXPORT_MAX_TOTAL_MB=500

# Schreibschutz für Demo-Modus (nur Platzhalter, echten Wert nur lokal setzen)
DEMO_READ_ONLY=true
ADMIN_PIN=change_me_in_local_env

# Ports
DAGSTER_PORT=3000
STREAMLIT_PORT=8501
